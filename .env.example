# Copy this file to .env and fill in real values. Never commit .env.

# API key for your chosen AI image provider (example: Replicate).
# Get one at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_your_token_here

# The specific pose-transfer model to call, in "owner/model:version" form.
POSE_MODEL_ID=owner/pose-transfer-model:version_hash

# The exact origin your frontend is served from (locks down CORS).
ALLOWED_ORIGIN=https://your-app-domain.com

PORT=3000
